# ── Required ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=            # https://aistudio.google.com/apikey
ALPHA_VANTAGE_API_KEY=     # https://www.alphavantage.co/support/#api-key (free)

# SEC asks automated clients to identify themselves: "AppName contact@email"
SEC_USER_AGENT="StockBot-Demo/2.0 you@example.com"

# ── Optional: demo protection ───────────────────────────────────────────────
# DEMO_ACCESS_CODE=recruiter2026   # require a shared code for all API calls
# GEMINI_DAILY_LIMIT=300           # global LLM calls per UTC day
# AV_DAILY_LIMIT=25                # global Alpha Vantage calls per UTC day
# FILING_INGEST_DAILY_LIMIT=20     # new 10-Ks downloaded+indexed per day
# CHAT_PER_MINUTE=6                # per visitor IP
# CHAT_PER_DAY=40                  # per visitor IP
# RAG_INGEST_PER_DAY=5             # per visitor IP
# UPLOAD_PER_DAY=5                 # per visitor IP
# MAX_UPLOAD_MB=5
# TRUSTED_PROXY_HOPS=1             # 1 behind Render/App Runner/Fly, 0 if exposed directly

# ── Optional: other ─────────────────────────────────────────────────────────
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite
# GEMINI_FAST_MODEL=gemini-3.1-flash-lite   # used for the quick intent-classification call
# GEMINI_THINKING_LEVEL=minimal             # minimal|low|medium|high; lower = faster replies
# CORS_ORIGINS=https://your-frontend.vercel.app   # only if frontend is on another origin
